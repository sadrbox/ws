# ── Адреса установки (У2 плана PLAN_INSTALL_MODES_2026-09-24.md) ──────────────
#
# Задаются ПРИ СБОРКЕ (vite читает их в момент `npm run build`). Раньше адрес API выводился
# из имени хоста браузера — на чужом сервере это отправляло запросы клиента к нам.
#
# Адрес API бэкенда вместе с префиксом. Пусто — берётся тот же источник, что у страницы
# (`<origin>/api/v1`), то есть фронт и бэкенд за одним прокси. Это верно для типовой установки.
VITE_API_URL=

# Адрес AI-сервиса (помощник, чат 1С, администрирование 1С). Пусто — разделы помощника
# работать не будут; это нормально, если он в поставку не входит.
VITE_AI_SERVICE_URL=

# ── Модули поставки ──────────────────────────────────────────────────────────
# Управление 1С (кластеры, агенты, расширение БухПроф-AI) — раздел консалтинговой компании.
# На клиентской установке: VITE_MODULE_ONEC=0 — раздела нет ни в меню, ни в сборке (чанк не
# создаётся вовсе). На бэкенде тогда же MODULE_ONEC=0, иначе маршрут останется отвечать.
# VITE_MODULE_ONEC=0
# Сервер лицензий ЭСФ — только у центральной установки БухПроф (К6).
# VITE_MODULE_ESF_LICENSING=0

# ── Совместимость с исторической раскладкой (фронт :5173, бэкенд :3000) ───────
# Нужны ТОЛЬКО на нашем стенде. На новой установке оставить пустыми и задать VITE_API_URL.
# VITE_LOCAL_API_URL=http://192.168.1.112:3000/api/v1
# VITE_REMOTE_API_URL=https://api.aleppo.kz/api/v1
# VITE_LOCAL_AI_URL=http://192.168.1.112:3100
# VITE_AI_URL=https://ai.buhprof.kz

# ── Dev-сервер (HMR) ─────────────────────────────────────────────────────────
# VITE_HMR_HOST=
# VITE_HMR_PROTOCOL=
# VITE_HMR_CLIENT_PORT=
