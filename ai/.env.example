# BuhProf AI Service — переменные окружения. Рабочий файл: ai/.env (в git не попадает).
PORT=3100
NODE_ENV=production

# Своя база сервиса (создана: CREATE DATABASE buhprof_ai OWNER prisma_user)
DATABASE_URL=postgresql://prisma_user:ПАРОЛЬ@localhost:5432/buhprof_ai

# База ERP — только чтение users/access_rights для авторизации пользователей.
# То же значение, что DATABASE_URL в backend/.env
ERP_DATABASE_URL=postgresql://prisma_user:ПАРОЛЬ@localhost:5432/buhprof

# Тот же секрет, что JWT_SECRET в backend/.env — чтобы принимать токены ERP как есть
JWT_SECRET=

# Служебный канал ERP (/bpai): задачи и заметки организации в чате внутри 1С.
# ERP_API_KEY — то же значение, что BPAI_API_KEY в backend/.env. Пусто — задачи и заметки
# выключены: чат работает как прежде, модель их инструментов не видит.
ERP_API_URL=http://127.0.0.1:5000
ERP_API_KEY=
ERP_API_TIMEOUT_MS=15000

# Ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Ключ администратора AI Service: регистрация агентов, служебные вызовы. Любая длинная строка.
AGENT_ADMIN_KEY=

# Публичный адрес сервиса — для ссылок в ответах и проверки
PUBLIC_URL=https://ai.buhprof.kz
LOG_LEVEL=info

# Origins браузерных клиентов (ERP-фронт), через запятую. Агентам CORS не нужен.
ALLOWED_ORIGINS=https://aleppo.kz,http://localhost:5173,http://tauri.localhost

# ── Агенты (мост в 1С) ────────────────────────────────────────────────────────
POLL_MAX_WAIT_SECS=30          # макс. длина long-poll агента
AGENT_OFFLINE_AFTER_SECS=90    # агент офлайн, если heartbeat молчал дольше
AGENT_ORG_BINDING=strict       # strict — команды агенту своей орг; any — любой онлайн (dev)

# ── Диалог с моделью ──────────────────────────────────────────────────────────
CONFIRM_WRITE=true             # спрашивать подтверждение перед созданием документа (WRITE)
LLM_EFFORT=medium              # глубина рассуждений: low|medium|high|xhigh|max
CHAT_COMMAND_TIMEOUT_SECS=120  # сколько ждать результат команды из 1С за один ход
CHAT_MAX_TOOL_ROUNDS=8         # предел раундов «модель → инструменты» за ход

# ── Вложения и файлы диалога ──────────────────────────────────────────────────
# Модель для чтения PDF выписок (пусто → основная LLM_MODEL). Точность важнее цены.
BANK_EXTRACT_MODEL=
# Предел размера входящего вложения (PDF), МБ (1–30). Лимит тела = value*4+2 МБ.
# Предел размера ОДНОГО файла. В живой установке — 30; здесь то же значение, чтобы пример не расходился
# с тем, что работает (аудит 22.09).
CHAT_ATTACHMENT_MAX_MB=30

# Сколько файлов принимать в одном сообщении чата 1С: пачка выписок за месяц — обычный случай.
CHAT_ATTACHMENTS_MAX=20

# Предел тела JSON у всех маршрутов, кроме веб-чата ERP (там вложения идут base64 и предел свой).
# Канал 1С шлёт вложения отдельным запросом POST /v1/onec-chat/uploads, поэтому ходу хватает.
JSON_BODY_MAX_MB=5

# Сколько ждать 1С при чтении долгов и остатков в карточке организации (ПН9): они считаются по регистрам,
# и общего предела команд панели (ONEC_COMMAND_TIMEOUT_SECS) базе часто мало.
ORG_FINANCE_TIMEOUT_SECS=60
# Сколько дней хранить файлы диалога в chat_files (входящие вложения + выданные
# печатные формы/отчёты); 1–365. Просроченные удаляются при старте и раз в час.
FILE_TTL_DAYS=7

# ── Канал «расширение 1С ↔ сервис» (docs/TASK_SERVICE_ONEC_CHAT_CHANNEL_2026-09-21.md) ──
# Через сколько дней токен базы меняется сам. Новый токен едет базе в ответе обычного хода,
# расширение сохраняет его само. 0 — смена только по кнопке «Сменить» в карточке базы.
BASE_TOKEN_ROTATE_DAYS=90
# Сколько прежний токен принимается после смены: расширение сохраняет новый не мгновенно,
# а запрос, ушедший ровно в этот миг, не должен получить отказ.
BASE_TOKEN_OVERLAP_HOURS=24
# Версия расширения, с которой оно умеет сохранить присланный токен. Сборки старше не трогаем:
# новый токен они проигнорируют и через перекрытие остались бы без связи.
ONEC_EXT_ROTATION_MIN=1.5.0
# Версия расширения, ниже которой канал отвечает 426 EXT_TOO_OLD. Пусто — не проверяем.
ONEC_EXT_MIN_VERSION=
# Сколько помнить ключ хода (Idempotency-Key): повтор в пределах срока получает тот же ответ.
ONEC_TURN_KEY_TTL_HOURS=24

# ── Задачи и заметки организации из 1С (docs/PLAN_TASKS_NOTES_PANEL_SERVICE_2026-09-22.md) ──
# Адрес панели для ссылок на задачи, которые уходят в 1С (без завершающей косой черты).
# Пусто — ссылок нет вовсе: неоткрывающаяся ссылка хуже её отсутствия.
PUBLIC_PANEL_URL=
# Изменяющие вызовы задач и заметок в минуту на пару «база + пользователь» (0 — без лимита).
# Отдельно от общего лимита чата: за ходом стоит человек, пишущий текст, а задачи создаются списком.
RATE_LIMIT_TASKS_WRITE_PER_MIN=20
