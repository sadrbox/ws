# BuhProf AI Service — переменные окружения. Рабочий файл: ai/.env (в git не попадает).
PORT=3100
NODE_ENV=production

# Своя база сервиса (создана: CREATE DATABASE buhprof_ai OWNER prisma_user)
DATABASE_URL=postgresql://prisma_user:ПАРОЛЬ@localhost:5432/buhprof_ai

# База ERP — только чтение users/access_rights для авторизации пользователей.
# То же значение, что DATABASE_URL в backend/.env
ERP_DATABASE_URL=postgresql://prisma_user:ПАРОЛЬ@localhost:5432/buhprof

# Тот же секрет, что JWT_SECRET в backend/.env — чтобы принимать токены ERP как есть
JWT_SECRET=

# Ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5

# Ключ администратора AI Service: регистрация агентов, служебные вызовы. Любая длинная строка.
AGENT_ADMIN_KEY=

# Публичный адрес сервиса — для ссылок в ответах и проверки
PUBLIC_URL=https://ai.buhprof.kz
LOG_LEVEL=info

# Origins браузерных клиентов (ERP-фронт), через запятую. Агентам CORS не нужен.
ALLOWED_ORIGINS=https://aleppo.kz,http://localhost:5173,http://tauri.localhost

# ── Агенты (мост в 1С) ────────────────────────────────────────────────────────
POLL_MAX_WAIT_SECS=30          # макс. длина long-poll агента
AGENT_OFFLINE_AFTER_SECS=90    # агент офлайн, если heartbeat молчал дольше
AGENT_ORG_BINDING=strict       # strict — команды агенту своей орг; any — любой онлайн (dev)

# ── Диалог с моделью ──────────────────────────────────────────────────────────
CONFIRM_WRITE=true             # спрашивать подтверждение перед созданием документа (WRITE)
LLM_EFFORT=medium              # глубина рассуждений: low|medium|high|xhigh|max
CHAT_COMMAND_TIMEOUT_SECS=120  # сколько ждать результат команды из 1С за один ход
CHAT_MAX_TOOL_ROUNDS=8         # предел раундов «модель → инструменты» за ход

# ── Вложения и файлы диалога ──────────────────────────────────────────────────
# Модель для чтения PDF выписок (пусто → основная LLM_MODEL). Точность важнее цены.
BANK_EXTRACT_MODEL=
# Предел размера входящего вложения (PDF), МБ (1–30). Лимит тела = value*4+2 МБ.
CHAT_ATTACHMENT_MAX_MB=20
# Сколько дней хранить файлы диалога в chat_files (входящие вложения + выданные
# печатные формы/отчёты); 1–365. Просроченные удаляются при старте и раз в час.
FILE_TTL_DAYS=7
