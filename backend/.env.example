# ── База данных ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ── Сервер ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Авторизация (JWT) ────────────────────────────────────────
# Генерация: openssl rand -hex 64
JWT_SECRET=your_random_secret_here_use_openssl_rand_hex_64
JWT_EXPIRES_IN=24h

# ── CORS (разрешённые домены через запятую) ───────────────────
CORS_ORIGIN=http://localhost:5173
# IP хоста(ов) cloudflared/обратного прокси через запятую. Если задано — к :3000
# допускаются только эти источники (+loopback). Пусто = гард выключен.
TRUSTED_PROXY_IPS=

# ── Фискальная интеграция (Kaspi) ─────────────────────────────
# По умолчанию stub (фейковые фискальные данные для разработки/тестов).
# Боевой режим: FISCAL_PROVIDER=kaspi + заполнить ключи (по договору с Kaspi).
FISCAL_PROVIDER=stub
KASPI_API_URL=
KASPI_API_TOKEN=
KASPI_TRADE_POINT_ID=

# ── ИС ЭСФ РК (электронные счета-фактуры) ─────────────────────
# Контур: test3 (тестовый, по умолчанию) | prod (боевой — НЕ для отладки).
# ESF_BASE_URL переопределяет контур целиком (напр. локальный сервер SDK).
ESF_ENV=test3
ESF_BASE_URL=
# БИН предприятия (обязателен для сессии) и код проекта (если выдан).
ESF_TIN=
ESF_PROJECT_CODE=
ESF_TIMEOUT_MS=30000

# ── Открытые данные eGov (data.egov.kz) — рег. данные ЮЛ по БИН ─────────────
# Набор и ключ выдаются в кабинете data.egov.kz. Без них автозаполнение отключено.
EGOV_BASE_URL=https://data.egov.kz/api/v4
EGOV_API_KEY=
EGOV_DATASET=
EGOV_DATASET_VERSION=v1
EGOV_TIMEOUT_MS=15000

# Ключ приёмника событий 1С (POST /pipe, заголовок X-Api-Key)
PIPE_API_KEY=

# ── Лицензирование ЭСФ (1С-расширение esf_exchange) ──────────────────────────
# Общий секрет подписи токена лицензии. ДОЛЖЕН побайтово совпадать со значением,
# зашитым в 1С (CommonModules.ЛицензированиеЭСФ). Не коммитить реальное значение.
LICENSE_TOKEN_SECRET=
# TTL кэша токена у 1С (часы, 1..168). Дефолт 4 (S-03). Это и есть окно автономной
# работы: сколько расширение работает после отключения БИН или потери связи.
LICENSE_TOKEN_TTL_HOURS=4
# HMAC-ключи подписи (S-05): {"kid":"<ключ>", …}. Пока пусто — подпись считается
# старой схемой sha256(secret|data|secret), совместимой с установленным 1С.
LICENSE_TOKEN_KEYS=
# kid, которым подписывать НОВЫЕ токены. Включать ТОЛЬКО после перевода 1С на
# серверную проверку /verify (задача T-13): старый клиент HMAC-подпись не примет.
LICENSE_TOKEN_ACTIVE_KID=
# Лимит одновременных установок (баз 1С) на БИН (S-07). Переопределяется полем
# «Лимит установок» в карточке лицензии.
LICENSE_INSTALL_LIMIT=2
# true — при превышении лимита отказывать в токене; иначе только учёт и пометка
# в журнале/админке (по умолчанию false, чтобы не отключить действующих клиентов).
LICENSE_INSTALL_LIMIT_ENFORCE=false
# Через сколько суток без heartbeat установка перестаёт считаться живой.
LICENSE_INSTALL_STALE_DAYS=30
# Срок хранения журнала обращений (S-06), суток; 0 — не чистить.
LICENSE_LOG_RETENTION_DAYS=180
# Кэш состояния лицензии для POST /verify (секунды). 0 — читать БД каждый раз.
LICENSE_VERIFY_CACHE_SECONDS=60
# Куда сообщать о НОВОЙ заявке на активацию (S-09): URL, принимающий JSON POST.
LICENSE_ALERT_WEBHOOK_URL=
