# ── База данных ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# ── Сервер ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Доступ и модули: рубильники этапа перехода (план INSTALL_MODES, 24.09) ────
# Каждый по умолчанию безопасен — меняет поведение только когда задан явно.
#
# Маршрут, не описанный ни в ROUTE_TO_MODEL, ни в ROUTE_SUBJECTS:
#   observe (умолчание) — пропускается, пишется предупреждение [access] в журнал;
#   deny                — 403. Включать ПОСЛЕ раздачи профилей прав и прогона сценариев.
# ACCESS_UNKNOWN_ROUTES=observe
#
# Гард модулей: full (умолчание) — отключённый модуль закрыт на всех методах;
#               create-only     — прежнее поведение: запрещено только создание документов.
# MODULE_GUARD=full
#
# Доступ оператора установки к УЧЁТНЫМ данным:
#   always       (умолчание) — как раньше: суперадмин видит все данные всегда;
#   support-mode             — только на время включённого режима поддержки (/admin/support-mode),
#                              с причиной и следом в журнале. Администрирование работает всегда.
# OPERATOR_DATA_ACCESS=always

# ── Модули поставки (Б5 плана DEPLOY_AND_MODULES) ─────────────
# Управление 1С (кластеры, агенты, расширение) — раздел консалтинговой компании БухПроф.
# На установке клиента: MODULE_ONEC=0 здесь и VITE_MODULE_ONEC=0 при сборке фронта.
# Маршрут тогда не монтируется вовсе — честный 404 вместо «скрыли в меню».
# MODULE_ONEC=0

# ── Резервные копии БД (E1.3) ─────────────────────────────────
# Копии делает встроенный планировщик — отдельного cron не нужно. 0 или пусто = выключено,
# и это худшее из возможных состояний: у установки нет ни одной копии, пока её не включат.
# Значение — часы между копиями; свежая копия за этот срок пропускается (напр. после ручной).
BACKUP_INTERVAL_HOURS=24
# Сколько копий хранить (по умолчанию 14) — отдельно для каждого вида: база ERP, база сервиса ИИ, uploads.
BACKUP_RETENTION_COUNT=14
# Каталог на ДРУГОМ носителе (сетевая папка, второй диск): набор копий дублируется туда и ротируется.
# Не задан — копии лежат только на этом сервере и пропадут вместе с его диском.
# BACKUP_COPY_DIR=/mnt/backup/aleppo
# База сервиса ИИ копируется вместе с базой ERP. Адрес по умолчанию — DATABASE_URL из ../ai/.env той же
# установки; задать явно, если сервис стоит иначе, или off — не копировать.
# BACKUP_AI_DATABASE_URL=
# Архив каталога uploads (загруженные файлы) в каждом наборе; off — не архивировать.
# BACKUP_UPLOADS=on

# ── Разработка: всевластный «admin» (по умолчанию ВЫКЛЮЧЕНО) ──
# Раньше любой пользователь с именем admin получал полный доступ мимо прав, если
# NODE_ENV != production — а это умолчание pm2. На чужом сервере это дыра, поэтому
# теперь включается явно и только вне production. Вместе с ним разрешён вход без
# пароля (для отладки). В production переменная не действует вовсе.
# DEV_UNRESTRICTED_ADMIN=1

# ── Авторизация (JWT) ────────────────────────────────────────
# Генерация: openssl rand -hex 64
JWT_SECRET=your_random_secret_here_use_openssl_rand_hex_64
JWT_EXPIRES_IN=24h

# ── CORS (разрешённые домены через запятую) ───────────────────
CORS_ORIGIN=http://localhost:5173
# IP хоста(ов) cloudflared/обратного прокси через запятую. Если задано — к :3000
# допускаются только эти источники (+loopback). Пусто = гард выключен.
TRUSTED_PROXY_IPS=

# ── Фискальная интеграция (Kaspi) ─────────────────────────────
# По умолчанию stub (фейковые фискальные данные для разработки/тестов).
# Боевой режим: FISCAL_PROVIDER=kaspi + заполнить ключи (по договору с Kaspi).
FISCAL_PROVIDER=stub
KASPI_API_URL=
KASPI_API_TOKEN=
KASPI_TRADE_POINT_ID=

# ── ИС ЭСФ РК (электронные счета-фактуры) ─────────────────────
# Контур: test3 (тестовый, по умолчанию) | prod (боевой — НЕ для отладки).
# ESF_BASE_URL переопределяет контур целиком (напр. локальный сервер SDK).
ESF_ENV=test3
ESF_BASE_URL=
# БИН предприятия (обязателен для сессии) и код проекта (если выдан).
ESF_TIN=
ESF_PROJECT_CODE=
ESF_TIMEOUT_MS=30000

# ── Открытые данные eGov (data.egov.kz) — рег. данные ЮЛ по БИН ─────────────
# Набор и ключ выдаются в кабинете data.egov.kz. Без них автозаполнение отключено.
EGOV_BASE_URL=https://data.egov.kz/api/v4
EGOV_API_KEY=
EGOV_DATASET=
EGOV_DATASET_VERSION=v1
EGOV_TIMEOUT_MS=15000

# Ключ приёмника событий 1С (POST /pipe, заголовок X-Api-Key)
PIPE_API_KEY=

# Ключ служебного канала BuhProf AI (/bpai/*, заголовок X-Api-Key): по нему AI-сервис
# читает и пишет задачи и заметки организации для чата внутри 1С. ОТДЕЛЬНЫЙ от
# PIPE_API_KEY — у каналов разные владельцы. То же значение в ai/.env как ERP_API_KEY.
BPAI_API_KEY=

# ── Лицензирование ЭСФ (1С-расширение esf_exchange) ──────────────────────────
# Общий секрет подписи токена лицензии. ДОЛЖЕН побайтово совпадать со значением,
# зашитым в 1С (CommonModules.ЛицензированиеЭСФ). Не коммитить реальное значение.
LICENSE_TOKEN_SECRET=
# TTL кэша токена у 1С (часы, 1..168). Дефолт 4 (S-03). Это и есть окно автономной
# работы: сколько расширение работает после отключения БИН или потери связи.
LICENSE_TOKEN_TTL_HOURS=4
# HMAC-ключи подписи (S-05): {"kid":"<ключ>", …}. Пока пусто — подпись считается
# старой схемой sha256(secret|data|secret), совместимой с установленным 1С.
LICENSE_TOKEN_KEYS=
# kid, которым подписывать НОВЫЕ токены. Включать ТОЛЬКО после перевода 1С на
# серверную проверку /verify (задача T-13): старый клиент HMAC-подпись не примет.
LICENSE_TOKEN_ACTIVE_KID=
# Лимит одновременных установок (баз 1С) на БИН (S-07). Переопределяется полем
# «Лимит установок» в карточке лицензии.
LICENSE_INSTALL_LIMIT=2
# true — при превышении лимита отказывать в токене; иначе только учёт и пометка
# в журнале/админке (по умолчанию false, чтобы не отключить действующих клиентов).
LICENSE_INSTALL_LIMIT_ENFORCE=false
# Через сколько суток без heartbeat установка перестаёт считаться живой.
LICENSE_INSTALL_STALE_DAYS=30
# Срок хранения журнала обращений (S-06), суток; 0 — не чистить.
LICENSE_LOG_RETENTION_DAYS=180
# Кэш состояния лицензии для POST /verify (секунды). 0 — читать БД каждый раз.
LICENSE_VERIFY_CACHE_SECONDS=60
# Куда сообщать о НОВОЙ заявке на активацию (S-09): URL, принимающий JSON POST.
LICENSE_ALERT_WEBHOOK_URL=

# ── E17 «Стандарт качества» (docs/PLAN_QUALITY_STANDARD_2026-09-25.md) ──────────────
# Периодические правила качества (SLA, эскалации, регламентные задачи, находки проверок,
# посещаемость). off — выключить разом, например на копии базы для отладки.
QUALITY_JOBS=on
# Telegram-бот личных уведомлений (СК0.4). Пусто — бот выключен, уведомления только в ERP.
# ПРОВЕРИТЬ ПОТОМ: бот не создан; нужен исходящий доступ сервера к api.telegram.org.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — для ссылки привязки t.me/<имя>?start=<код>.
TELEGRAM_BOT_NAME=
